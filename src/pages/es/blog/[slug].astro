---
import type { InferGetStaticPropsType } from 'astro';
import BlogPostView from '../../../features/blog/BlogPostView.astro';
import { getPublishedPosts, getPostSlug } from '../../../content/blog';

export const getStaticPaths = async () => {
  const posts = await getPublishedPosts('es');
  return posts.map((post) => ({ params: { slug: getPostSlug(post) }, props: { post } }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post }: Props = Astro.props;
---

<BlogPostView locale="es" post={post} />
