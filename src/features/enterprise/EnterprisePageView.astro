---
// /enterprise – Mentarika for teams. The product is built but not open: the page says so first,
// and takes interest by email until the inquiry endpoint is switched on.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ENTERPRISE, SITE } from '../../consts';
import { getDict, localeHome, localePath, localeUrl, type Locale } from '../../i18n/index';
import EnterpriseForm from './EnterpriseForm.astro';
import EnterpriseUseCases from './EnterpriseUseCases.astro';
import EnterprisePrivacy from './EnterprisePrivacy.astro';
import EnterpriseRoles from './EnterpriseRoles.astro';
import FlowSteps from '../landing/FlowSteps.astro';
import Footer from '../../components/shared/Footer.astro';
import Nav from '../../components/shared/Nav.astro';
import SectionHead from '../../components/shared/SectionHead.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const e = t.enterprise;
const origin = Astro.site ?? new URL(SITE.domain);
const articleHref = localePath(locale, 'blog/ai-interview-practice-for-engineering-teams');

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE.name, item: localeUrl(locale, origin) },
    {
      '@type': 'ListItem',
      position: 2,
      name: e.hero.eyebrow,
      item: new URL(localePath(locale, 'enterprise'), origin).href,
    },
  ],
};
---

<BaseLayout
  locale={locale}
  title={e.metaTitle}
  description={e.metaDescription}
  jsonLd={[breadcrumb]}
>
  <Nav locale={locale} homeHref={localeHome(locale)} />
  <main id="main">
    <section class="ent-hero">
      <div class="container ent-hero__inner">
        <p class="eyebrow" data-reveal style="--d:0">
          {e.hero.eyebrow}
        </p>
        <h1 class="display" data-reveal style="--d:1">
          {e.hero.title}
        </h1>
        <p class="lede" data-reveal style="--d:2">
          {e.hero.lede}
        </p>
        <p class="ent-status" role="note" data-reveal style="--d:2">
          <span class="pill ent-status__label">
            <span class="dot" aria-hidden="true" />
            {e.status.label}
          </span>
          <span>{e.status.body}</span>
        </p>
        <div class="ent-hero__cta" data-reveal style="--d:3">
          <a class="btn" href="#contact">
            {e.hero.primary}
          </a>
          <a class="link-arrow" href={articleHref}>
            {e.hero.secondary} →
          </a>
        </div>
      </div>
    </section>

    <EnterpriseUseCases locale={locale} />

    <section class="ent-steps">
      <div class="container">
        <SectionHead eyebrow={e.steps.eyebrow} heading={e.steps.heading} />
        <FlowSteps steps={e.steps.items} />
      </div>
    </section>

    <EnterprisePrivacy locale={locale} />
    <EnterpriseRoles locale={locale} />

    <section class="ent-contact">
      <div class="container">
        {ENTERPRISE.inquiriesOpen ? (
          <EnterpriseForm locale={locale} />
        ) : (
          <div class="ent-interest" id="contact">
            <p class="eyebrow">{e.status.label}</p>
            <p class="ent-interest__body">{e.status.body}</p>
            <p class="ent-interest__contact">
              {e.status.contact}{' '}
              <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>
            </p>
          </div>
        )}
        <a class="article" href={articleHref}>
          <span class="eyebrow">{e.article.eyebrow}</span>
          <span class="article__title">{e.article.title}</span>
          <span class="article__cta mono">{e.article.cta} →</span>
        </a>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>

<style>
  .ent-hero {
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }
  .ent-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 60rem;
  }
  .ent-hero__inner .lede {
    max-width: 58ch;
  }
  .ent-hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem 1.8rem;
    margin-top: 0.4rem;
  }

  .ent-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    max-width: 58ch;
    margin: 0;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-subtle);
    color: var(--text);
  }
  .ent-status__label {
    flex: none;
  }

  .ent-interest {
    display: grid;
    gap: 0.8rem;
    padding: clamp(1.6rem, 4vw, 3rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-subtle);
  }
  .ent-interest__body {
    max-width: 52ch;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.5rem);
    font-weight: 600;
  }
  .ent-interest__contact a {
    color: var(--accent-ink);
    font-weight: 600;
  }

  .ent-steps {
    background: var(--surface-subtle);
    border-block: 1px solid var(--line);
  }

  .article {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s;
  }
  .article:hover {
    border-color: var(--line-strong);
  }
  .article__title {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.5rem);
    font-weight: 600;
  }
  .article__cta {
    color: var(--accent-ink);
  }

  @media (max-width: 820px) {
  }
</style>
