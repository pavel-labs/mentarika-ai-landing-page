---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/shared/Nav.astro';
import Footer from '../../components/shared/Footer.astro';
import type { Locale } from '../../i18n/index';
import { getDict } from '../../i18n/index';
import { getPublishedPosts, clustersWithPosts, getPostSlug } from '../../content/blog';
import { localePath, localeHome } from '../../i18n/index';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);

const posts = await getPublishedPosts(locale);
const clusters = clustersWithPosts(posts);
---

<BaseLayout
  locale={locale}
  title={`${t.contentHub.resources.eyebrow} – Mentarika`}
  description={t.contentHub.resources.lede}
>
  <Nav locale={locale} homeHref={localeHome(locale)} />
  <main id="main" class="hub">
    <div class="container hub__inner">
      <p class="eyebrow">{t.contentHub.resources.eyebrow}</p>
      <h1 class="h2">{t.contentHub.resources.title}</h1>
      <p class="hub__intro">{t.contentHub.resources.lede}</p>

      <div class="hub__grid">
        {clusters.map((cluster) => (
          <section class="cluster">
            <h2 class="cluster__title">{t.contentHub.blog.clusters[cluster.id].title}</h2>
            <p class="cluster__lede">{t.contentHub.blog.clusters[cluster.id].lede}</p>
            <ul class="cluster__list">
              {cluster.posts.map((post) => (
                <li class="cluster__item">
                  <a href={localePath(locale, `blog/${getPostSlug(post)}`)}>
                    <strong>{post.data.title}</strong>
                    <span>{post.data.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>

<style>
  .hub {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .hub__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .hub__intro {
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 46rem;
  }
  .hub__grid {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .cluster {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.2rem;
    background: color-mix(in oklab, var(--surface-subtle) 52%, transparent);
  }
  .cluster__title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }
  .cluster__lede {
    margin-top: 0.5rem;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .cluster__list {
    margin-top: 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    list-style: none;
  }
  .cluster__item a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .cluster__item strong,
  .cluster__item span {
    overflow-wrap: anywhere;
  }
  .cluster__item strong {
    color: var(--text);
  }
  .cluster__item span {
    color: var(--text-muted);
    line-height: 1.55;
  }
  .cluster__item a:hover strong {
    color: var(--accent-ink);
  }
  @media (max-width: 860px) {
    .hub__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
